#!/usr/bin/env bash
set -euo pipefail

# Resolve TOOL_ROOT correctly even when this script is invoked via a symlink.
_gs_script="${BASH_SOURCE[0]}"
while [[ -L "$_gs_script" ]]; do
  _gs_dir="$(cd "$(dirname "$_gs_script")" && pwd)"
  _gs_target="$(readlink "$_gs_script")"
  if [[ "$_gs_target" == /* ]]; then
    _gs_script="$_gs_target"
  else
    _gs_script="$_gs_dir/$_gs_target"
  fi
done
TOOL_ROOT="$(cd "$(dirname "$_gs_script")/.." && pwd)"
unset _gs_script _gs_dir _gs_target
COMMAND="${1:-}"
shift || true

# --- Reserved tokens, resolved before any filesystem lookup -----------
# help/-h/--help and the --version/-V aliases apply only at this first
# dispatcher token position; leaf argv is forwarded unchanged.
case "$COMMAND" in
  --version|-V)
    exec "$TOOL_ROOT/commands/version.sh" "$@"
    ;;
  help|-h|--help|"")
    cat <<EOF
git-shadow

Diff-sync utilities for public/@local branch pairs.

Commands:
  git shadow version [<ignored>...]
  git shadow install-hooks [<ignored>...]
  git shadow doctor [--fix]
  git shadow status [--json]
  git shadow commit (-m <message>|-m<message>|--message <message>|<message>)
  git shadow show --with-annotations <file> [--color]
  git shadow annotations reapply [path] [<ignored>...]
  git shadow local add <path> [<ignored>...]
  git shadow local rm [--revert] <path> [<ignored>...]
  git shadow local diff [path] [<ignored>...]
  git shadow local apply [<ignored>...]
  git shadow completion install [<ignored>...]
  git shadow feature start [<name> [--worktree|--worktree-dir <path>]]
  git shadow feature list [--json]
  git shadow feature publish [<ignored>...]
  git shadow feature sync [--recover] [--continue|--abort]
  git shadow feature finish ([<name>]|--continue|--abort|--mark-applied <sha>) [--no-pull] [--keep-branches] [--keep-worktree]
  git shadow base sync [--recover] [--continue|--abort]
  git shadow re-anchor [<branch@local>] [<ignored>...]
  git shadow push <branch> [<ignored>...]
  git shadow check public [<public-branch>] [<ignored>...]
  git shadow config list [--json] [<ignored>...]
  git shadow config show [--json] [<ignored>...]
  git shadow config get <KEY> [--json] [<ignored>...]
  git shadow config set [<KEY>[=<VALUE>] [<VALUE>]] [--project-config|--user-config] [<ignored>...]
  git shadow config unset <KEY> [--project-config|--user-config] [<ignored>...]

Examples:
  git shadow commit -m "add user model"
  git shadow feature start feature/login
  git shadow feature publish
  git shadow feature sync
  git shadow feature finish
  git shadow base sync
  git shadow re-anchor feature/login@local
  git shadow push feature/login
  git shadow check public feature/login
  git shadow status --json
  git shadow config show
  git shadow config get LOCAL_SUFFIX
  git shadow config set LOCAL_SUFFIX=@mine --project-config
  git shadow config unset LOCAL_SUFFIX --project-config
EOF
    exit 0
    ;;
esac

# --- Two-level dispatch: git shadow <group> <subcommand> ---
# If commands/<COMMAND>/ is a directory, treat the next arg as a subcommand.
if [[ -n "$COMMAND" && -d "$TOOL_ROOT/commands/$COMMAND" ]]; then
  SUBCOMMAND="${1:-}"
  case "$SUBCOMMAND" in
    help|-h|--help)
      # Group usage = one Usage: line per leaf, delegated to leaf handlers.
      for _gs_leaf in "$TOOL_ROOT/commands/$COMMAND"/*.sh; do
        "$_gs_leaf" --help
      done
      unset _gs_leaf
      exit 0
      ;;
    "")
      echo "❌ Missing subcommand for '$COMMAND'." >&2
      echo "   Run 'git shadow $COMMAND --help' for usage." >&2
      exit 1
      ;;
  esac
  shift
  script="$TOOL_ROOT/commands/$COMMAND/$SUBCOMMAND.sh"
  if [[ -f "$script" ]]; then
    exec "$script" "$@"
  fi
  echo "❌ Unknown subcommand '$SUBCOMMAND' for '$COMMAND'." >&2
  echo "   Run 'git shadow help' for usage." >&2
  exit 1
fi

# --- One-level dispatch: git shadow <command> ---
if [[ -n "$COMMAND" && -f "$TOOL_ROOT/commands/$COMMAND.sh" ]]; then
  exec "$TOOL_ROOT/commands/$COMMAND.sh" "$@"
fi

echo "❌ Unknown command: $COMMAND" >&2
echo "   Run 'git shadow help' for usage." >&2
exit 1
