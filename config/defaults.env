# -------------------------------------------------------------------
# Workspace configuration
# -------------------------------------------------------------------
# Path to the directory containing your Git projects.
# If relative, it is resolved from the toolkit directory.
# Example: "../" means projects are next to the toolkit repo.
WORKSPACE_DIR="../"

# -------------------------------------------------------------------
# Branch configuration
# -------------------------------------------------------------------
# Main public branch used for integration.
PUBLIC_BASE_BRANCH="main"
# Suffix used for local shadow branches that keep private comments.
LOCAL_SUFFIX="@local"

# -------------------------------------------------------------------
# Shadow commit filtering
# -------------------------------------------------------------------
# Regex matched against the `git shadow commit` public-message argument to reject
# memory-style subjects. Does NOT drive classification — memory-class commits are
# those whose subject begins with SHADOW_COMMIT_PREFIX or literal [MEMORY].
SHADOW_COMMIT_FILTER='^\[MEMORY\]'

# Subject prefix for memory-class commits (manual local-only commits and the
# toolkit's sidecar commits). Classification matches this prefix OR the literal
# [MEMORY] — history predates reconfiguration. An empty/blank prefix or one
# beginning with [CHECKPOINT]/[SYNC] is invalid (load_env warns): it emits
# sidecar subjects the literal consumers misread. Note: any other prefix value
# (e.g. "feat:") also reclassifies matching public commits as memory — choose a
# prefix no public commit should carry.
SHADOW_COMMIT_PREFIX='[MEMORY]'

# -------------------------------------------------------------------
# Hook configuration
# -------------------------------------------------------------------
# Marker line used to detect if hook content is already installed.
HOOK_CHECK_MARKER="# git-shadow pre-commit hook"

# -------------------------------------------------------------------
# Merge commit messages
# -------------------------------------------------------------------
# Message used when syncing public branch into local shadow branch.
SYNC_MERGE_MESSAGE_TEMPLATE="[SYNC] merge '%s' into '%s'"
# Message used when integrating a local feature branch into local base.
FEATURE_MERGE_MESSAGE_TEMPLATE="[FEATURE] merge '%s' into '%s'"

# -------------------------------------------------------------------
# Worktree configuration
# -------------------------------------------------------------------
# Parent directory for feature worktrees created by
# `git shadow feature start <name> --worktree`. Empty disables the flag;
# use `--worktree-dir <path>` or set this via `git shadow config set`.
# Must be absolute after ~ expansion and is created via mkdir -p on use.
WORKTREE_ROOT=""

# -------------------------------------------------------------------
# Agents template configuration
# -------------------------------------------------------------------
# Template flavor written into the managed AGENTS.local.md block by
# `git shadow agents sync` and checked by `git shadow doctor`.
# Valid values: full (AGENTS.template.md), ultra (AGENTS.template.ultra.md).
AGENTS_TEMPLATE="full"

# -------------------------------------------------------------------
# Local comment extraction
# -------------------------------------------------------------------
# Regular expression matching triple-slash local comments.
LOCAL_COMMENT_PATTERN_TRIPLE='^\s*///'

# Regular expression matching explicit local-only markers.
LOCAL_COMMENT_PATTERN_LOCAL='^\s*// @local'

# Space-separated Bash extended glob patterns. These files are skipped when
# scanning for LOCAL_COMMENT_PATTERN_TRIPLE. LOCAL_COMMENT_PATTERN_LOCAL is
# still honored. Paths under .git-shadow/annotations/ are never excluded.
LOCAL_COMMENT_EXCLUDE=".git-shadow/!(annotations) .git-shadow/!(annotations)/* *.cs *.rs *.swift *.fs *.csx *.razor *.d.ts *.bats docs/git-shadow-as-ia-memory-layer.md"

# Jaccard similarity threshold for fuzzy hunk re-anchoring.
ANNOTATION_FUZZY_THRESHOLD="0.80"
